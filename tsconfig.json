{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "rootDir": "src",
    "outDir": "./build",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "expo-modules-core": ["../civilianpro-customer/node_modules/expo-modules-core"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "build"]
}
